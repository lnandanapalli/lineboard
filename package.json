{
  "name": "lineboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Handwriting whiteboard for tablets without an active pen: write above a movable line, rest your hand on the locked part below it.",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "playwright test",
    "screenshot": "SCREENSHOT=1 playwright test tests/readme-screenshot.spec.ts"
  },
  "dependencies": {
    "@fontsource/patrick-hand": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
