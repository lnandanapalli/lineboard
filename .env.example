# For local development only (npm run dev). Copy to .env.local and fill in.
# In Docker, set SUPABASE_URL and SUPABASE_ANON_KEY on the container instead.
# Supabase Dashboard -> Project Settings -> API. Use the anon / publishable key, NEVER the service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
